# SahaTN - variables d'environnement (exemple)
# Copier vers .env puis adapter. Ne jamais committer de secrets reels.

NODE_ENV=development

# PostgreSQL (identifiants de developpement uniquement)
DB_NAME=sahatn
DB_USER=sahatn
DB_PASSWORD=sahatn
DB_PORT=5432

# Ports exposes
BACKEND_PORT=4000
FRONTEND_PORT=3000

# URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Sessions (cookies)
SESSION_COOKIE_NAME=sahatn_session
CSRF_COOKIE_NAME=sahatn_csrf
SESSION_TTL_SECONDS=604800
COOKIE_DOMAIN=

# Anti-force brute (par compte)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Limitation de debit (requetes/minute)
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=20
REGISTER_THROTTLE_LIMIT=10

# Documents medicaux : espace de stockage prive (hors repertoire public).
# Laisser vide pour utiliser <backend>/storage/private-documents.
DOCUMENT_STORAGE_DIR=
# Taille maximale d'un document en octets (defaut : 5 Mio).
DOCUMENT_MAX_FILE_BYTES=5242880
