# SahaTN backend - variables d'environnement (exemple)
# Ne jamais committer de secrets reels. Copier vers .env et adapter.

NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (identifiants de developpement uniquement)
DATABASE_URL=postgresql://sahatn:sahatn@localhost:5432/sahatn

# Sessions (cookies)
SESSION_COOKIE_NAME=sahatn_session
CSRF_COOKIE_NAME=sahatn_csrf
SESSION_TTL_SECONDS=604800
# Laisser vide en local. Renseigner le domaine en production si necessaire.
COOKIE_DOMAIN=

# Anti-force brute (par compte)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Limitation de debit (requetes/minute)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=20
REGISTER_THROTTLE_LIMIT=10

# Documentation OpenAPI (Swagger). Absent : disponible hors production,
# desactivee en production. Forcer l'exposition avec `true`.
# ENABLE_API_DOCS=true

# Documents medicaux : espace de stockage prive (hors repertoire public).
# Laisser vide pour utiliser <backend>/storage/private-documents.
DOCUMENT_STORAGE_DIR=
# Taille maximale d'un document en octets (defaut : 5 Mio).
DOCUMENT_MAX_FILE_BYTES=5242880

# Compte administrateur : cree via `npm run create-admin` avec ADMIN_EMAIL et
# ADMIN_PASSWORD fournis en variables d'environnement (jamais dans le depot).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
