# SahaTN frontend - variables d'environnement (exemple)

NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL interne du backend utilisee par le proxy Next.js (/api/* vers cette URL).
# Ne pas exposer de secret ici.
API_URL=http://localhost:4000

# Bandeau de demonstration. Actif par defaut ; ne mettre a false que pour un
# deploiement interne non public.
NEXT_PUBLIC_DEMO_MODE=true
